{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "rootDir": "."
  },
  "include": [
    "src/main/**/*",
    "src/shared/**/*",
    "test/**/*"
  ]
}
