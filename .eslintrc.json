{
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "commonjs",
    "ecmaFeatures": {
      "globalReturn": true
    }
  },
  "env": {
    "node": true,
    "browser": true,
    "es2022": true
  },
  "globals": {
    "electron": "readonly",
    "electronAPI": "readonly"
  },
  "rules": {
    "semi": [
      "error",
      "always"
    ],
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "no-console": "off",
    "no-undef": "error",
    "no-unreachable": "error",
    "no-extra-semi": "error",
    "no-irregular-whitespace": "error",
    "no-unexpected-multiline": "error",
    "no-redeclare": "error",
    "no-shadow": "warn",
    "no-mixed-spaces-and-tabs": "error",
    "indent": [
      "error",
      2,
      {
        "SwitchCase": 1
      }
    ],
    "quotes": [
      "warn",
      "single",
      {
        "avoidEscape": true
      }
    ],
    "comma-dangle": [
      "error",
      "never"
    ],
    "no-trailing-spaces": "error",
    "eol-last": "error",
    "no-multiple-empty-lines": [
      "error",
      {
        "max": 2,
        "maxEOF": 1
      }
    ]
  },
  "ignorePatterns": [
    "dist/",
    "build/",
    "node_modules/",
    "*.min.js"
  ],
  "overrides": [
    {
      "files": [
        "src/renderer/js/modules/*.js"
      ],
      "rules": {
        "no-shadow": "off"
      },
      "globals": {
        "AppState": "readonly",
        "CONSTANTS": "readonly",
        "ERRORS": "readonly",
        "Elements": "readonly",
        "applyFilters": "readonly",
        "debounce": "readonly",
        "escapeAttr": "readonly",
        "escapeHtml": "readonly",
        "fetchAllMappings": "readonly",
        "findAndDisplayMatchedRule": "readonly",
        "formatDuration": "readonly",
        "getLocalDateString": "readonly",
        "getWorkDayEndMinutes": "readonly",
        "getWorkDayStartMinutes": "readonly",
        "initBreakReminder": "readonly",
        "invalidateAnalyticsCache": "readonly",
        "loadActivities": "readonly",
        "loadActivityTypeManager": "readonly",
        "loadAnalyticsView": "readonly",
        "loadProjectManager": "readonly",
        "loadSettingsView": "readonly",
        "loadTagManager": "readonly",
        "markBreak": "readonly",
        "openClearDataModal": "readonly",
        "openDeleteModal": "readonly",
        "openEditModal": "readonly",
        "openManualEntryModal": "readonly",
        "openTagEditor": "readonly",
        "parseLocalDateString": "readonly",
        "safeLocalStorageSet": "readonly",
        "showNotification": "readonly",
        "switchView": "readonly",
        "toggleTracking": "readonly"
      }
    },
    {
      "files": [
        "src/renderer/js/app.js"
      ],
      "rules": {
        "no-unused-vars": "off",
        "no-shadow": "off"
      }
    },
    {
      "files": [
        "src/shared/sanitize.js"
      ],
      "rules": {
        "no-control-regex": "off"
      }
    },
    {
      "files": [
        "browser-extension/**/*.js"
      ],
      "env": {
        "browser": true,
        "webextensions": true,
        "node": false
      },
      "parserOptions": {
        "sourceType": "script"
      },
      "rules": {
        "indent": [
          "error",
          4,
          {
            "SwitchCase": 1
          }
        ]
      }
    }
  ]
}
