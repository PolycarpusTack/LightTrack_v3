{
  "name": "lighttrack",
  "version": "3.0.0",
  "description": "Local-first Windows timesheet assistance and work-evidence capture",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/with-env.js NODE_ENV=development electron .",
    "build": "node scripts/build.js",
    "build:prod": "node scripts/with-env.js NODE_ENV=production node scripts/build.js",
    "electron:build:win": "electron-builder --win --publish never",
    "test": "npm run test:baseline",
    "test:baseline": "jest --config jest.baseline.config.js --runInBand",
    "test:legacy": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "npm run test:baseline",
    "test:app": "playwright test",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "lint:ci": "eslint src --ext .js --format json --output-file lint-results.json",
    "clean": "node -e \"for (const d of ['dist', 'coverage']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "prerelease": "npm run test:ci && npm run lint:ci",
    "release": "npm run build:prod && npm run electron:build:win",
    "update-manifest": "node scripts/update-manifest.js",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix"
  },
  "keywords": [
    "time-tracking",
    "timesheet",
    "sap",
    "electron"
  ],
  "author": "LightSuite Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "commander": "^14.0.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "eslint": "^8.57.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2"
  },
  "dependencies": {
    "active-win": "^7.7.2",
    "electron-log": "^5.4.3",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.6.2",
    "node-ical": "^0.22.1"
  },
  "build": {
    "appId": "com.lightsuite.lighttrack",
    "productName": "LightTrack",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!src/**/*.test.js",
      "!src/**/*.map"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
